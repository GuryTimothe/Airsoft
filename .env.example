# Read by Docker Compose itself, before any service. They select the development
# pair, so plain `docker compose up` builds the dev images: docker-compose.yml
# alone declares no build context for backend and frontend and cannot start them.
# The separator is set explicitly because Compose defaults to ';' on Windows.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

POSTGRES_DB=app
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_USER=app

# Ports. Change these when another app or environment already uses a default.
# BACKEND_PORT and FRONTEND_PORT set both the container's listen port and the
# published host port, so one value moves the service end to end.
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Host side only: Postgres and Redis keep their standard ports inside the
# container. Published in development only, for connecting a local client.
DB_PORT=5432
REDIS_PORT=6379

APP_DEBUG=1
APP_ENV=dev
APP_SECRET=change-me-app-secret
DEFAULT_URI=https://api.example.test
CORS_ALLOW_ORIGIN=^https?://([a-z0-9-]+\\.)?example\\.(test|com)(:[0-9]+)?$

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-jwt-passphrase
JWT_ISSUER=https://api.example.test
JWT_AUDIENCE=https://api.example.test
JWT_INACTIVITY_TIMEOUT=1800
LOGIN_CSRF_TOKEN_TTL=600

MAILER_DSN=smtp://login:brevo-smtp-key@smtp-relay.brevo.com:587?encryption=tls&auth_mode=login
MAILER_FROM=no-reply@example.com
FRONTEND_URL=https://www.example.test

DATABASE_URL=postgresql://app:change-me-db-password@database:5432/app?serverVersion=18&charset=utf8
REDIS_URL=redis://redis:6379

NEXT_PUBLIC_API_URL=https://api.example.test
INTERNAL_API_URL=https://backend.internal.example.test

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FIRSTNAME=Admin
SUPER_ADMIN_LASTNAME=User
SUPER_ADMIN_PASSWORD=ChangeMe123!
