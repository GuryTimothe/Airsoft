POSTGRES_DB=app
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_USER=app

FRONTEND_PORT=3000

APP_DEBUG=1
APP_ENV=dev
APP_SECRET=change-me-app-secret
DEFAULT_URI=https://api.example.test
CORS_ALLOW_ORIGIN=^https?://([a-z0-9-]+\\.)?example\\.(test|com)(:[0-9]+)?$

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-jwt-passphrase
JWT_ISSUER=https://api.example.test
JWT_AUDIENCE=https://api.example.test
JWT_INACTIVITY_TIMEOUT=1800
LOGIN_CSRF_TOKEN_TTL=600

DATABASE_URL=postgresql://app:change-me-db-password@database:5432/app?serverVersion=18&charset=utf8
REDIS_URL=redis://redis:6379

NEXT_PUBLIC_API_URL=https://api.example.test
# Optionnel: utilisé uniquement si le frontend doit joindre l'API via un accès interne privé.
INTERNAL_API_URL=

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FIRSTNAME=Admin
SUPER_ADMIN_LASTNAME=User
SUPER_ADMIN_PASSWORD=ChangeMe123!
