# syntax=docker/dockerfile:1

# FrankenPHP (Caddy + PHP embedded in a single binary) replaces the PHP built-in
# server, which is single-request-at-a-time and explicitly unsupported in production.
# One process serves both static files and PHP, so no php-fpm + nginx + supervisor stack.
FROM dunglas/frankenphp:1.13.3-php8.4-alpine AS base

# install-php-extensions ships with the FrankenPHP images.
RUN install-php-extensions \
        intl \
        pdo_pgsql \
        opcache \
        apcu

WORKDIR /app


FROM base AS vendor

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock symfony.lock ./

RUN composer install \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --no-scripts \
        --no-dev \
        --optimize-autoloader


FROM base AS runner

# SERVER_NAME as a bare port (no hostname) makes Caddy serve plain HTTP and skip
# automatic TLS: the Coolify proxy terminates HTTPS in front of this container.
ENV APP_ENV=prod \
    APP_DEBUG=0 \
    SERVER_NAME=:8000

COPY docker/php/prod.ini /usr/local/etc/php/conf.d/zz-app.ini

# vendor/ is excluded by .dockerignore, so the application copy cannot clobber it.
COPY . .
COPY --from=vendor /app/vendor ./vendor

# docker-entrypoint.sh is tracked as 0644 in git, so the exec bit is set here.
# /data and /config are Caddy's XDG dirs, declared by the base image.
RUN addgroup -S app-group \
    && adduser -S app-user -G app-group \
    && mkdir -p var/cache var/log config/jwt \
    && chmod +x docker-entrypoint.sh \
    && chown -R app-user:app-group /app /data /config

USER app-user

EXPOSE 8000

# Exercises the database and Redis, not just the HTTP listener, so Coolify only
# shifts traffic to a container whose dependencies actually answer.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=30s \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Consumed by docker-php-entrypoint, which the FrankenPHP image rewrites to
# exec `frankenphp run`.
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
