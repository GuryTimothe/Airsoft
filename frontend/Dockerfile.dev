FROM node:26-alpine

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN apk add --no-cache tini \
	&& addgroup -S app-group \
	&& adduser -S app-user -G app-group

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN chown -R app-user:app-group /app

USER app-user

# next's --port option declares .env('PORT'), so the env var alone sets the port.
# Kept in exec form rather than passing a ${PORT} flag through a shell, which
# would leave /bin/sh as PID 1's child and swallow SIGTERM on shutdown.
ENV PORT=3000

EXPOSE ${PORT}

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]